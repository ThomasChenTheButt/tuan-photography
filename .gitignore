# macOS system files
.DS_Store

# Python's compiled leftovers from running tools/
__pycache__/

# Claude Code local tooling (skills, preview config) — not part of the website
.claude/

# Original full-res photos stay on your Mac only — the website uses the
# web-sized copies in images/web/. Keeps the repo small and your originals private.
images/*/
!images/web/

# Saved reference images and videos — often other people's work, and this
# repo is public, so they stay on your Mac. IDEAS.md (the notes) is still saved.
ideas/

# loose originals dropped straight into images/ (not the web copies)
images/*.jpg
images/*.jpeg
images/*.png
images/*.heic

# Impeccable working files: review screenshots and decision-page payloads stay local
.impeccable/review/
.impeccable/decision/
.impeccable/briefs-src/

# Experiments — trial copies of the site, each on its own branch (see CLAUDE.md).
# The folders live here; their contents belong to their own branches, not to main.
experiments/
