# macOS system files
.DS_Store

# Python's compiled leftovers from running tools/
__pycache__/

# Claude Code local tooling (skills, preview config) — not part of the website
.claude/

# Your original full-res photos stay on your Mac only — the website uses the
# web-sized copies in site/images/web/. Keeps the repo small and your originals private.
# The photo list inside is private too: it can show photos that aren't published.
originals/*
!originals/README.md

# Safety net: anything dropped into the site's images by mistake stays private as well.
# Only the web copies in site/images/web/ are saved.
site/images/*
!site/images/web/

# The old drop location, retired 2026-09-28. If the folder ever comes back, it stays private.
/images/

# Saved reference images and videos — often other people's work, and this
# repo is public, so they stay on your Mac. IDEAS.md (the notes) is still saved.
ideas/

# Your own notes. Private, so they stay on your Mac.
/我的筆記.txt

# Impeccable working files: review screenshots and decision-page payloads stay local
.impeccable/review/
.impeccable/decision/
.impeccable/briefs-src/

# Experiments — trial copies of the site, each on its own branch (see CLAUDE.md).
# The folders live here; their contents belong to their own branches, not to main.
experiments/
